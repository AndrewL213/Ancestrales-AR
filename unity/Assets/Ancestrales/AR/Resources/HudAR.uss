/* Interfaz AR de Ancestrales — misma paleta que la UI del juego:
   verde casi negro, pergamino, rojo y rosas. */

.ar-raiz {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    flex-direction: column;
    justify-content: space-between;
}

/* ---------- Barra superior ---------- */
.ar-barra {
    flex-direction: row;
    align-items: center;
    background-color: rgba(14, 26, 20, 0.82);
    border-radius: 14px;
    padding: 10px 12px;
    border-width: 1px;
    border-color: rgba(239, 227, 200, 0.25);
}
.ar-textos { flex-grow: 1; }
.ar-titulo {
    color: rgb(239, 227, 200);
    font-size: 22px;
    -unity-font-style: bold;
}
.ar-subtitulo {
    color: rgb(232, 160, 160);
    font-size: 13px;
}
.ar-contador {
    color: rgb(239, 227, 200);
    font-size: 15px;
    margin-right: 10px;
    padding: 4px 10px;
    border-radius: 10px;
    background-color: rgba(155, 34, 38, 0.85);
}

/* ---------- Centro ---------- */
.ar-centro {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}
.ar-valoracion {
    color: rgb(255, 232, 150);
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(14, 26, 20);
    transition-property: opacity;
    transition-duration: 0.35s;
}
.ar-mensaje {
    color: rgb(239, 227, 200);
    font-size: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 300px;
    margin-top: 220px;
    padding: 8px 14px;
    border-radius: 12px;
    background-color: rgba(14, 26, 20, 0.7);
}

/* ---------- Abajo ---------- */
.ar-abajo { align-items: center; }
.ar-acciones {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 8px;
}
.ar-modos {
    flex-direction: row;
    background-color: rgba(14, 26, 20, 0.82);
    border-radius: 14px;
    padding: 4px;
}

.ar-boton, .ar-modo, .ar-boton-redondo {
    border-width: 0;
    margin: 0 4px;
    color: rgb(239, 227, 200);
    font-size: 15px;
}
.ar-boton {
    background-color: rgba(155, 34, 38, 0.92);
    border-radius: 12px;
    padding: 10px 16px;
    -unity-font-style: bold;
}
.ar-boton:hover { background-color: rgb(178, 48, 52); }
.ar-boton:active { scale: 0.96 0.96; }
.ar-boton:disabled { opacity: 0.45; }

.ar-boton-redondo {
    width: 38px; height: 38px;
    border-radius: 19px;
    background-color: rgba(239, 227, 200, 0.15);
    font-size: 18px;
}

.ar-modo {
    background-color: rgba(0, 0, 0, 0);
    border-radius: 10px;
    padding: 9px 14px;
}
.ar-modo--activo {
    background-color: rgb(239, 227, 200);
    color: rgb(14, 26, 20);
    -unity-font-style: bold;
}

/* ---------- Resultado ---------- */
.ar-resultado {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(14, 26, 20, 0.55);
    align-items: center;
    justify-content: center;
}
.ar-tarjeta {
    width: 300px;
    padding: 22px;
    border-radius: 18px;
    background-color: rgb(239, 227, 200);
    align-items: center;
    border-width: 3px;
    border-color: rgb(155, 34, 38);
}
.ar-res-titulo {
    color: rgb(155, 34, 38);
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}
.ar-res-texto {
    color: rgb(14, 26, 20);
    font-size: 15px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}
